# ==========================================
# SUPABASE CONFIGURATION (Free Tier)
# ==========================================
# Obtain these from your Supabase Project Settings -> API:
# https://supabase.com/dashboard/project/_/settings/api

# Your project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your project Anon / Publishable API Key (safe to use in client apps)
# NEVER put your service_role secret key here!
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here
